APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=518400
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# Where private uploads (documents, policies, form files, employee docs) live.
# Set to s3 for durable off-server storage — reads AND writes use this disk, so
# flipping it moves everything cleanly. First: composer require league/flysystem-aws-s3-v3,
# fill the AWS_* keys below, then run:  php artisan storage:test s3
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# S3 (or S3-compatible: Cloudflare R2, MinIO, DigitalOcean Spaces) for private
# file storage. AWS_URL is optional (custom/CDN domain); AWS_ENDPOINT +
# AWS_USE_PATH_STYLE_ENDPOINT=true are for non-AWS S3-compatible providers.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Stripe billing (SaaS card payments). Leave empty to run without charging
# (plans activate instantly). Set these + run `composer require stripe/stripe-php`
# to take real payments. STRIPE_WEBHOOK_SECRET is from the Stripe webhook you add
# for the /stripe/webhook endpoint.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd

# Cloudflare Turnstile captcha on public signup (optional). Leave empty to
# disable. Get keys at dash.cloudflare.com → Turnstile.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Backups (built-in `backup:run`, scheduled daily). BACKUP_DISK is where copies
# land; set BACKUP_UPLOAD_DISK=s3 for off-site. On Linux mysqldump is usually on
# PATH; on Windows/XAMPP set the full path.
BACKUP_DISK=local
BACKUP_UPLOAD_DISK=
BACKUP_MYSQLDUMP_PATH=mysqldump
BACKUP_KEEP_DAYS=14
BACKUP_INCLUDE_FILES=true

# Transactional email — for production set MAIL_MAILER to a real provider
# (smtp/ses/postmark/resend) with a verified sending domain and SPF/DKIM/DMARC.
# Test it with:  php artisan mail:test you@yourdomain.com

# Error tracking (optional but recommended for production). Install with
# `composer require sentry/sentry-laravel` then set the DSN — it auto-registers,
# no code change needed. Uptime monitor should watch: https://your-domain/health
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
