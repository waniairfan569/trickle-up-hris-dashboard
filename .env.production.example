# ============================================================
# TrickleUp Hub — PRODUCTION env template for hour.trickleup.co
# Copy this to ".env" ON THE SERVER and fill in the real values.
# NEVER commit the real .env (it is git-ignored).
# Generate APP_KEY on the server with:  php artisan key:generate
# ============================================================

APP_NAME="TrickleUp Hub"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://hour.trickleup.co

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=UTC

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# --- Logging (keep low verbosity in prod) ---
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# --- Database (create these in Plesk > Databases) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=trickleup_hris
DB_USERNAME=trickleup_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Session / Cache / Queue (all DB-backed; tables ship in migrations) ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Share cookie across subdomains if you add an SPA later; otherwise leave as the host:
SESSION_DOMAIN=.trickleup.co
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=sync          # sync = process inline, no worker needed. Switch to "database" + a queue:work task later.

FILESYSTEM_DISK=local

# --- Sanctum (token API). Add your SPA/mobile origin host(s) here, comma-separated ---
SANCTUM_STATEFUL_DOMAINS=hour.trickleup.co

# --- Mail (REQUIRED: invitations + notifications send email) ---
# Laravel 13 uses MAIL_SCHEME (NOT MAIL_ENCRYPTION). Valid schemes: smtp | smtps.
#   - Port 465  -> MAIL_SCHEME=smtps  (implicit TLS)   <-- recommended for Gmail
#   - Port 587  -> MAIL_SCHEME=smtp   (STARTTLS)
# Gmail: enable 2-Step Verification, create an App Password (16 chars), and paste it
# with NO spaces. MAIL_FROM_ADDRESS must be the SAME Gmail address (Gmail rewrites it
# otherwise and the message is rejected / marked spam).
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=your-account@gmail.com
MAIL_PASSWORD=your16charapppassword
MAIL_SCHEME=smtps
MAIL_FROM_ADDRESS="your-account@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

# After editing this file on the server, ALWAYS run:  php artisan config:clear
# Then test:  php artisan mail:test you@example.com

# --- Realtime broadcasting (OPTIONAL) ---
# Live notifications/attendance updates. If you do NOT run a websocket server,
# leave this as "log" and the app works fine without push updates.
BROADCAST_CONNECTION=log
# To enable Pusher instead, set BROADCAST_CONNECTION=pusher and fill these:
# PUSHER_APP_ID=
# PUSHER_APP_KEY=
# PUSHER_APP_SECRET=
# PUSHER_APP_CLUSTER=mt1
